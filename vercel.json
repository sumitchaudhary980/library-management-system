{
 "version": 2,
 "builds": [
 { "src": "backend/src/server.js", "use": "@vercel/node" },
 { "src": "frontend/**", "use": "@vercel/static" }
 ],
 "routes": [
 { "src": "/api/(.*)", "dest": "backend/src/server.js" },
 { "src": "/$", "dest": "/frontend/index.html" },
 { "src": "/(.*)", "dest": "frontend/$1" }
 ]
}